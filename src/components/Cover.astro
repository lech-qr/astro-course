---
import { joinClasses } from '../utils/joinClasses';
import { Image } from 'astro:assets';
type Props = {
    classes: string;
    styles: string;
    url?: string;
    width: number;
    height: number;
    dimRatio?: number;
    overlayColor?: string;
    customOverlayColor?: string;
}
const {classes, styles, url, width, height, dimRatio = 50, overlayColor, customOverlayColor} = Astro.props;

let overlayStyle = "";
if(customOverlayColor){
    overlayStyle = `background: ${customOverlayColor}`;
}
if(overlayColor){
    overlayStyle = `background: var(--color--${overlayColor})`;
}
---
<div class={joinClasses(classes, "relative")} style={styles}>
    {!!url &&
        <Image 
            class="absolute w-full h-full max-w-full! object-cover" 
            width={width || 999} 
            height={height || 999} 
            src={url} alt="" />
    }
    <div 
        class="absolute top-0 right-0 bottom-0 left-0 bg-black max-w-full! mt-0!" 
        style={`opacity: ${dimRatio / 100}; ${overlayStyle}`} 
    >test</div>
    <div class="relative flex flex-col justify-center min-h-430px z-10 mt-0!">
        <slot />
    </div>

</div>